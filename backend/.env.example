# Copy this file to `.env` for local development.
# Keep real values only in `.env` or in the deployment secrets manager.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
JWT_SECRET="replace-with-a-random-secret-with-at-least-32-characters"
FRONTEND_URL="http://localhost:5173"
RESEND_API_KEY="re_..."
EMAIL_FROM="Pet+ <no-reply@seudominio.com.br>"
# EMAIL_REPLY_TO="contato@seudominio.com.br"

PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Optional: error monitoring. Without a DSN, Sentry stays disabled and the API
# runs normally. Get it at Sentry > Settings > Projects > [project] > Client Keys.
SENTRY_DSN=""

# PGT-1: disabled by default; only test seller accounts are accepted.
MERCADO_PAGO_ENABLED=false
# MERCADO_PAGO_ACCESS_TOKEN="token-from-test-seller-application"
# MERCADO_PAGO_TEST_USER_ID="numeric-test-seller-id"
# MERCADO_PAGO_WEBHOOK_SECRET="webhook-signature-secret"
# BACKEND_PUBLIC_URL="https://api-petplus.up.railway.app"
# FRONTEND_URL must also use HTTPS when Mercado Pago is enabled.
